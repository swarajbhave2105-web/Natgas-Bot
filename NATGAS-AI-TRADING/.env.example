ENVIRONMENT=development
PORT=8000
EIA_API_KEY=

# Upstox market data (read-only; live order execution is hard-disabled)
UPSTOX_ACCESS_TOKEN=
UPSTOX_ANALYTICS_TOKEN=
UPSTOX_LIVE_ORDER_ENABLED=false

# AI Routing: OmniRoute is the primary universal gateway
NATGAS_ACTIVE_AI_ROUTE=omniroute
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto

# Optional direct provider overrides
NATGAS_DEEP_PROVIDER=openai
NATGAS_DEEP_MODEL=gpt-6-sol
NATGAS_DEEP_BASE_URL=

NATGAS_FAST_PROVIDER=openai
NATGAS_FAST_MODEL=gpt-6-luna
NATGAS_FAST_BASE_URL=

NATGAS_LLAMA_PROVIDER=openrouter
NATGAS_LLAMA_MODEL=meta-llama/llama-4-maverick
NATGAS_LLAMA_BASE_URL=

# AI Quota & Duplicate-Call Protection
NATGAS_AI_MAX_CALLS_PER_MINUTE=10
NATGAS_AI_MAX_CALLS_PER_HOUR=60
NATGAS_AI_CACHE_TTL_SECONDS=300
NATGAS_AI_CIRCUIT_COOLDOWN_SECONDS=60

# Runtime research provider, if enabled later.
EXA_API_KEY=

